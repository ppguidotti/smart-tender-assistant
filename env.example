# ===========================================================================
# Smart Tender Assistant — Environment configuration template
# ===========================================================================
# Copia questo file in `.env` e compila i valori reali.
# `.env` è gitignored — non committarlo MAI.
# ===========================================================================

# ---------------------------------------------------------------------------
# LLM — Azure (Gemini via Azure AI Foundry o Azure OpenAI)
# ---------------------------------------------------------------------------
# Provider attivo. Determina quali variabili sotto sono richieste.
# Opzioni: "azure_openai" | "azure_foundry"
LLM_PROVIDER=azure_foundry

# ---- Configurazione Azure OpenAI (GPT-4o, GPT-4, etc.) ----
# Lascia vuoto se usi azure_foundry
# Endpoint del tuo resource Azure OpenAI (formato: https://<resource>.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Nome del *deployment* (non del modello) — lo crei nel portale Azure
AZURE_OPENAI_DEPLOYMENT_EXTRACTOR=gpt-4o
AZURE_OPENAI_DEPLOYMENT_REASONER=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-small

# ---- Configurazione Azure AI Foundry (Gemini, Claude, Llama, …) ----
# Lascia vuoto se usi azure_openai
# Endpoint del deployment Foundry (formato: https://<project>.<region>.inference.ai.azure.com/)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Nome del deployment Gemini su Foundry (es. "gemini-1.5-pro")
AZURE_FOUNDRY_DEPLOYMENT_EXTRACTOR=gemini-1.5-pro
AZURE_FOUNDRY_DEPLOYMENT_REASONER=gemini-1.5-pro

# ---- Parametri condivisi per le chiamate LLM ----
# Bassa = output più deterministico (consigliato per estrazione strutturata)
LLM_TEMPERATURE=0.1
# Max output tokens per chiamata
LLM_MAX_OUTPUT_TOKENS=8192
# Timeout in secondi per ogni chiamata LLM
LLM_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Apache Tika
# ---------------------------------------------------------------------------
# URL del server Tika. Default per docker-compose locale.
TIKA_SERVER_URL=http://localhost:9998

# Timeout in secondi per chiamate Tika (cold start JVM puo' essere lento)
TIKA_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Qdrant — Vector store
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
# Per Qdrant Cloud, usa l'URL completo invece di host+port:
# QDRANT_URL=https://xyz.eu-central.aws.cloud.qdrant.io

# ---------------------------------------------------------------------------
# Storage filesystem per file binari
# ---------------------------------------------------------------------------
# Path locale dove salvare PDF originali, report generati, allegati
STA_FILES_ROOT=./data/files

# ---------------------------------------------------------------------------
# API — FastAPI backend (B8)
# ---------------------------------------------------------------------------
STA_API_HOST=0.0.0.0
STA_API_PORT=8000

# Per il client Streamlit, dove punta il backend
STA_API_BASE_URL=http://localhost:8000

# Modalità del client API usato dal frontend
# Opzioni: "mock" (legge da tests/fixtures/) | "http" (chiama il backend reale)
STA_API_MODE=mock

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Opzioni: DEBUG | INFO | WARNING | ERROR

# Formato output log: "json" (production) | "console" (dev, leggibile)
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Embedding model (per B3 RAG)
# ---------------------------------------------------------------------------
# Provider per gli embedding del profilo aziendale
# Opzioni: "azure_openai" (usa AZURE_OPENAI_DEPLOYMENT_EMBEDDING sopra)
#        | "azure_foundry" (richiede AZURE_FOUNDRY_DEPLOYMENT_EMBEDDING)
#        | "local" (sentence-transformers, gratis, richiede pip install ".[embeddings-local]")
EMBEDDING_PROVIDER=azure_openai

# Solo se EMBEDDING_PROVIDER=azure_foundry
AZURE_FOUNDRY_DEPLOYMENT_EMBEDDING=

# Solo se EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-large

# ---------------------------------------------------------------------------
# Sviluppo & debugging
# ---------------------------------------------------------------------------
# Stampa request/response LLM in log (solo dev, non in prod — fa rumore)
DEBUG_LLM_TRACES=false

# Disabilita rate limit nelle chiamate LLM durante test
DEBUG_DISABLE_RATE_LIMIT=false